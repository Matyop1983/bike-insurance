# Copy to `.env.local` for local development. Do not commit secrets.

# NowCerts / Momentum AMS webhook
NOWCERTS_AGENCY_ID=f3f521d1-ac53-4e82-9865-b9642378d129
# Optional overrides
# NOWCERTS_ENDPOINT=https://api.nowcerts.com/api/PushJsonQuoteApplications
# NOWCERTS_API_KEY=

# Internal quote notification (Resend). If these are unset, NowCerts still
# receives the quote and the server logs that email is pending env vars.
# RESEND_API_KEY=
# QUOTE_NOTIFY_TO=Matthew@Rhinoia.com
# QUOTE_NOTIFY_FROM=Rhino Quotes <quotes@your-verified-domain.com>

# Optional Cloudflare Turnstile. Leave both unset and every quote form
# keeps working with the honeypot, the 3-second time check, and the
# note filter only. Set both to render an invisible/managed widget
# (appearance: interaction-only) and verify the token in /api/quote.
# One key without the other does not turn verification on.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
